{
  "name": "bluecore-watcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:gen": "tsx scripts/schema-gen.ts",
    "schema:check": "tsx scripts/schema-gen.ts --check",
    "validate:config": "tsx scripts/validate-config.ts",
    "ingest": "tsx scripts/ingest.ts",
    "gate": "tsx scripts/gate.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "config/*.config.ts": [
      "npx tsx scripts/validate-staged-config.ts"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "domhandler": "5.0.3",
    "dompurify": "^3.4.15",
    "jsonpath-plus": "^10.3.0",
    "marked": "^18.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.1",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.4",
    "wrangler": "^4.131.1"
  }
}
