{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "config", "tests"],
  // src/app/ is the SPA (React/JSX, DOM lib, bundler resolution) -- checked
  // separately by tsconfig.app.json so the engine's Node/ES2023 config
  // never has to accommodate it. tests/app/ mirrors that split.
  "exclude": ["src/app", "tests/app"]
}
